{
 "format": 1,
 "title_id": "0100D71004694000",
 "name": "Minecraft inventory",
 "min_runtime": 18,
 "_about": "Minecraft (Bedrock Edition, Switch) second-screen companion with two tabs. Inventory: the player's armor, health, air and hunger as the game's HUD draws them, above the 9x4 inventory grid (27 main slots above the 9 hotbar slots), separate helmet, chestplate, leggings and boots below the grid, durability bars for damageable items and a quiet warning at 10% or less durability on the selected pickaxe (Minecraft 1.2.12), item icons decoded by the native module from the player's own romfs resource packs, stack counts, the selected hotbar slot and its name as the game shows it, in the game's own font. Map: the chunks the game holds around the player, drawn by the module the way the game's map item draws them (each block's own map colour, shaded by height and water depth), on the game's map paper with its player marker, plus the player's coordinates and heading. The package ships no game assets.",
 "canvas_w": 1240,
 "canvas_h": 1080,
 "background": "#FF1E1E1E",
 "font": "file:mc_font.txt",
 "font_atlas": "module:mc:font/default8",
 "requires_module": true,
 "flags": {},
 "derived": [
  {
   "name": "ui.show_inventory",
   "all_nonzero": [
    "module_ready",
    "inv.ready"
   ]
  },
  {
   "name": "ui.sel_x",
   "expr": "68 + inv.selected * 124 - 6"
  },
  {
   "name": "ui.map_mx",
   "expr": "map.px * 768 / max(map.view, 1)"
  },
  {
   "name": "ui.map_my",
   "expr": "map.pz * 768 / max(map.view, 1)"
  }
 ],
 "page_binds": [
  {
   "point": "ui.show_inventory",
   "equals": 1,
   "when_equal": {
    "page": "inventory",
    "transition": "fade",
    "duration_ms": 200
   },
   "when_not_equal": {
    "page": "standby",
    "transition": "fade",
    "duration_ms": 200
   }
  }
 ],
