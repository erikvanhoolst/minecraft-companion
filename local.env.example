# Copy to local.env and adjust. local.env is not tracked by git: it points at files on this
# machine (your Eden Duo desktop build, your own game dump), which never belong in the project.

# Android NDK r28c (builds the module for the handheld).
ANDROID_NDK_ROOT=$HOME/.local/opt/android/android-ndk-r28c

# --- Desktop testing (optional) ---
# eden-cli from an Eden Duo checkout built with the patches in patches/ (see docs/TOOLS.md).
EDEN_CLI=/path/to/eden-duo/build/bin/eden-cli
# Your own Minecraft NSP.
MC_GAME=/path/to/Minecraft.nsp
# Vulkan driver for the desktop run. The GPU's own driver (Intel UHD 620: intel_icd.json) runs
# Minecraft 1.2.12 at 60 fps; llvmpipe (lvp_icd.json) needs no GPU but manages 1-5 fps, too slow
# for menus, where button presses fall between frames.
MC_VK_ICD=/usr/share/vulkan/icd.d/intel_icd.json
# Eden data folder the desktop build uses.
EDEN_DATA=$HOME/.local/share/eden
# Output of research/nso_reloc.py (rtti.json), used by scripts/probe.py.
MC_ANALYSIS=/path/to/analysis

# --- Handheld (optional) ---
ADB=$HOME/.local/bin/adb
