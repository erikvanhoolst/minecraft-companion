+// DSMod fork: on failure, explain which memory blocks in the range blocked the operation.
+static void LogPhysicalMemoryFailure(const char* what, KProcessPageTable& page_table, u64 addr,
+                                     u64 size, Result result) {
+    LOG_WARNING(Kernel_SVC, "{} failed: result=0x{:08X} addr={:#016x} size={:#x}", what,
+                result.raw, addr, size);
+    u64 cur = addr;
+    for (int guard = 0; guard < 64 && cur < addr + size; ++guard) {
+        KMemoryInfo info{};
+        Svc::PageInfo page_info{};
+        if (page_table.QueryInfo(std::addressof(info), std::addressof(page_info), cur).IsError())
+            break;
+        LOG_WARNING(Kernel_SVC, "  block {:#016x}+{:#x}: state={:#x} perm={:#x} attr={:#x}",
+                    info.GetAddress(), info.GetSize(),
+                    static_cast<u32>(info.GetState()), static_cast<u32>(info.GetPermission()),
+                    static_cast<u32>(info.GetAttribute()));
+        const u64 next = info.GetAddress() + info.GetSize();
+        if (next <= cur)
+            break;
+        cur = next;
+    }
+}
